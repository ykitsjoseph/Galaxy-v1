-- STAR BACKGROUND

local stars = Instance.new("Frame")
stars.Size = UDim2.fromScale(1, 1)
stars.BackgroundTransparency = 1
stars.ZIndex = 1
stars.Parent = main

task.spawn(function()
    while gui.Parent do
        local star = Instance.new("TextLabel")
        star.BackgroundTransparency = 1
        star.Text = "✦"
        star.TextColor3 = PURPLE
        star.TextSize = math.random(10, 19)
        star.Size = UDim2.fromOffset(20, 20)
        star.Position = UDim2.new(
            math.random(0, 100) / 100, 0, -0.1, 0
        )
        star.ZIndex = 1
        star.Parent = stars

        local tween = TweenService:Create(
            star,
            TweenInfo.new(
                math.random(4, 8),
                Enum.EasingStyle.Linear
            ),
            {
                Position = UDim2.new(
                    star.Position.X.Scale, 0, 1.1, 0
                ),
                TextTransparency = 0.8
            }
        )

        tween:Play()
        tween.Completed:Wait()
        star:Destroy()
    end
end)

