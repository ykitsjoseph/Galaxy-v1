-- BUTTON CREATOR

local function makeButton(text, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -30, 0, 40)
    b.Position = UDim2.fromOffset(15, y)
    b.BackgroundColor3 = Color3.fromRGB(48, 25, 70)
    b.Text = text
    b.TextColor3 = WHITE
    b.TextSize = 14
    b.Font = Enum.Font.GothamBold
    b.ZIndex = 4
    b.Parent = main

    Instance.new("UICorner", b).CornerRadius =
        UDim.new(0, 8)

    local outline = Instance.new("UIStroke")
    outline.Color = PURPLE
    outline.Thickness = 1
    outline.Parent = b

    return b
end

-- WHEELIE CONTROLS

local angle = 45
local wheelie = false

local WHEELIE_KEY = 0x11

local function pressKey(key)
    if typeof(keypress) == "function" then
        pcall(keypress, key)
    end
end

local function releaseKey(key)
    if typeof(keyrelease) == "function" then
        pcall(keyrelease, key)
    end
end

local wheelieButton = makeButton("WHEELIE: OFF", 65)

wheelieButton.MouseButton1Click:Connect(function()
    wheelie = not wheelie

    if wheelie then
        pressKey(WHEELIE_KEY)
    else
        releaseKey(WHEELIE_KEY)
    end

    wheelieButton.Text =
        "WHEELIE: " .. (wheelie and "ON" or "OFF")
end)

local angleButton = makeButton("WHEELIE ANGLE: 45°", 112)

angleButton.MouseButton1Click:Connect(function()
    angle = angle + 15

    if angle > 90 then
        angle = 30
    end

    angleButton.Text =
        "WHEELIE ANGLE: " .. angle .. "°"
end)

